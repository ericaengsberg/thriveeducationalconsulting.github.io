<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --forest: #2D5A27;
    --forest-dark: #1E3D1A;
    --forest-light: #4A7A43;
    --forest-pale: #C5D6C2;
    --cream: #F8F5EF;
    --cream-dark: #EDE5D4;
    --bark: #2C2C2A;
    --bark-light: #6B6B68;
    --white: #FDFAF5;
    --terracotta: #C17A5A;
    --terracotta-light: #DFA98A;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Lato', sans-serif;
    background: var(--cream);
    color: var(--bark);
    font-weight: 300;
    line-height: 1.75;
  }

  /* NAV */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    background: var(--white);
    border-bottom: 1px solid var(--cream-dark);
    padding: 0 2rem;
    display: flex; align-items: center; justify-content: space-between;
    height: 84px;
  }
  .nav-logo img { height: 58px; width: auto; display: block; }
  .nav-links { display: flex; gap: 2rem; list-style: none; align-items: center; }
  .nav-links a {
    text-decoration: none;
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--bark-light);
    transition: color 0.2s;
  }
  .nav-links a:hover { color: var(--forest); }
  .nav-cta { background: var(--forest) !important; color: var(--white) !important; padding: 0.45rem 1.2rem !important; border-radius: 2px !important; }
  .nav-cta:hover { background: var(--forest-light) !important; }
  .hamburger { display: none; flex-direction: column; gap: 5px; cursor: pointer; background: none; border: none; padding: 4px; }
  .hamburger span { width: 22px; height: 1.5px; background: var(--bark); display: block; }

  /* HERO LOGO */
  .hero-logo-wrap { margin-bottom: 1.5rem; }
  .hero-logo-wrap img { height: 90px; width: auto; display: block; }

  /* HERO */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center;
    padding: 100px 2rem 60px;
    background: var(--cream);
    position: relative; overflow: hidden;
  }
  .hero::before {
    content: '';
    position: absolute; top: 0; right: 0;
    width: 45%; height: 100%;
    background: var(--forest-pale);
    opacity: 0.2;
    clip-path: polygon(20% 0%, 100% 0%, 100% 100%, 0% 100%);
  }
  .hero-inner {
    max-width: 1100px; margin: 0 auto; width: 100%;
    display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;
    position: relative; z-index: 1;
  }
  .hero-eyebrow {
    font-size: 0.75rem; letter-spacing: 0.18em; text-transform: uppercase;
    color: var(--terracotta); font-weight: 400; margin-bottom: 1rem;
  }
  .hero h1 {
    font-family: 'Playfair Display', serif;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 1.18; font-weight: 400;
    color: var(--bark); margin-bottom: 1.5rem;
  }
  .hero h1 em { font-style: italic; color: var(--forest); }
  .hero-sub {
    font-size: 1.05rem; color: var(--bark-light);
    max-width: 440px; margin-bottom: 2.5rem; line-height: 1.8;
  }
  .hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; }
  .btn-primary {
    background: var(--forest); color: var(--white);
    padding: 0.85rem 2rem; text-decoration: none;
    font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase;
    border-radius: 2px; font-weight: 400; transition: background 0.2s;
  }
  .btn-primary:hover { background: var(--forest-light); }
  .btn-secondary {
    border: 1px solid var(--bark-light); color: var(--bark);
    padding: 0.85rem 2rem; text-decoration: none;
    font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase;
    border-radius: 2px; transition: border-color 0.2s, color 0.2s;
  }
  .btn-secondary:hover { border-color: var(--forest); color: var(--forest); }

  .hero-visual { display: flex; justify-content: center; align-items: center; }
  .hero-card {
    background: var(--white); border: 1px solid var(--cream-dark);
    border-radius: 4px; padding: 2.5rem; max-width: 360px; width: 100%;
    box-shadow: 0 8px 40px rgba(44,44,42,0.07);
  }
  .hero-card-label { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--terracotta); margin-bottom: 1.2rem; }
  .stat-row { display: flex; gap: 2rem; margin-bottom: 1.8rem; }
  .stat-num { font-family: 'Playfair Display', serif; font-size: 2rem; color: var(--bark); line-height: 1; }
  .stat-label { font-size: 0.78rem; color: var(--bark-light); margin-top: 4px; }
  .divider { border: none; border-top: 1px solid var(--cream-dark); margin: 1.2rem 0; }
  .hero-card-quote { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1rem; color: var(--bark-light); line-height: 1.65; }

  /* SECTION SHARED */
  section { padding: 90px 2rem; }
  .section-inner { max-width: 1100px; margin: 0 auto; }
  .section-eyebrow { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--terracotta); margin-bottom: 0.75rem; }
  .section-title { font-family: 'Playfair Display', serif; font-size: clamp(1.8rem, 3.5vw, 2.6rem); font-weight: 400; color: var(--bark); margin-bottom: 1.25rem; line-height: 1.25; }
  .section-sub { font-size: 1rem; color: var(--bark-light); max-width: 540px; line-height: 1.8; }

  /* ABOUT */
  #about { background: var(--white); }
  .about-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 5rem; align-items: start; }

  .about-photo-wrap { position: relative; }
  .about-photo-wrap { display: flex; flex-direction: column; align-items: center; gap: 1rem; padding-top: 1rem; }
  .about-photo {
    width: 220px; height: 220px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center top;
    display: block;
    border: 4px solid #2D5A27;
  }
  .about-name { font-family: "Playfair Display", serif; font-size: 1.1rem; color: var(--bark); text-align: center; }
  .about-founder { font-size: 0.72rem; letter-spacing: 0.15em; text-transform: uppercase; color: var(--forest); text-align: center; }
  .about-photo-placeholder {
    width: 100%; aspect-ratio: 3/4;
    background: var(--forest-pale); opacity: 0.5;
    border-radius: 4px;
    display: flex; align-items: center; justify-content: center;
    flex-direction: column; gap: 0.75rem;
  }
  .about-photo-placeholder span { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--forest-dark); opacity: 0.7; }
  .about-accent { position: absolute; bottom: -20px; right: -20px; width: 120px; height: 120px; background: var(--terracotta-light); opacity: 0.2; border-radius: 50%; }

  .about-text { padding-top: 0.5rem; }
  .about-intro { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.15rem; color: var(--bark-light); line-height: 1.7; margin-bottom: 1.75rem; border-left: 3px solid var(--forest-pale); padding-left: 1.25rem; }
  .about-body { font-size: 0.97rem; color: var(--bark-light); line-height: 1.85; margin-bottom: 1.1rem; }
  .about-body:last-of-type { margin-bottom: 1.75rem; }

  .credentials { display: flex; flex-direction: column; gap: 0.6rem; margin-top: 0.5rem; }
  .credential { display: flex; align-items: flex-start; gap: 0.75rem; font-size: 0.9rem; color: var(--bark-light); }
  .credential-dot { width: 6px; height: 6px; border-radius: 50%; background: var(--forest); margin-top: 8px; flex-shrink: 0; }

  /* TESTIMONIALS */
  #testimonials { background: var(--forest-dark); padding: 90px 2rem; }
  .testimonials-inner { max-width: 800px; margin: 0 auto; text-align: center; }
  .testimonials-eyebrow { font-size: 0.72rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--forest-pale); opacity: 0.7; margin-bottom: 0.75rem; }
  .testimonials-title { font-family: 'Playfair Display', serif; font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 400; color: var(--white); margin-bottom: 3rem; line-height: 1.3; }
  .carousel { position: relative; overflow: hidden; }
  .carousel-track { display: flex; transition: transform 0.5s ease; }
  .carousel-slide { min-width: 100%; padding: 0 0.5rem; }
  .testimonial-card { background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); border-radius: 4px; padding: 2.5rem 2.5rem 2rem; text-align: left; }
  .testimonial-quote { font-family: 'Playfair Display', serif; font-style: italic; font-size: 1.15rem; color: rgba(253,250,245,0.88); line-height: 1.8; margin-bottom: 1.5rem; }
  .testimonial-quote::before { content: '\201C'; font-size: 3rem; line-height: 0; vertical-align: -0.7rem; margin-right: 0.1rem; color: var(--forest-pale); opacity: 0.45; }
  .testimonial-attribution { font-size: 0.8rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--forest-pale); opacity: 0.65; }
  .carousel-controls { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-top: 2rem; }
  .carousel-btn { background: none; border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.6); width: 38px; height: 38px; border-radius: 50%; cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center; transition: border-color 0.2s, color 0.2s; }
  .carousel-btn:hover { border-color: rgba(255,255,255,0.6); color: var(--white); }
  .carousel-dots { display: flex; gap: 8px; }
  .carousel-dot { width: 7px; height: 7px; border-radius: 50%; background: rgba(255,255,255,0.25); border: none; cursor: pointer; padding: 0; transition: background 0.2s; }
  .carousel-dot.active { background: var(--forest-pale); }

  /* SERVICES */
  #services { background: var(--cream); }
  .services-intro { margin-bottom: 3.5rem; }
  .services-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1.5rem; }
  .service-card {
    background: var(--white); border: 1px solid var(--cream-dark);
    border-radius: 4px; padding: 2rem;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .service-card:hover { box-shadow: 0 6px 32px rgba(44,44,42,0.09); transform: translateY(-2px); }
  .service-icon { width: 44px; height: 44px; border-radius: 50%; background: var(--forest-pale); opacity: 0.8; display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; font-size: 1.2rem; }
  .service-title { font-family: 'Playfair Display', serif; font-size: 1.2rem; font-weight: 400; color: var(--bark); margin-bottom: 0.75rem; }
  .service-desc { font-size: 0.93rem; color: var(--bark-light); line-height: 1.75; }
  .service-tag { display: inline-block; margin-top: 1.2rem; font-size: 0.7rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--forest); border: 1px solid var(--forest-pale); padding: 3px 10px; border-radius: 2px; }

  /* BOOKING */
  #booking { background: var(--white); }
  .booking-grid { display: grid; grid-template-columns: 1fr 1.4fr; gap: 4rem; align-items: start; }
  .booking-feature { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1.25rem; }
  .booking-feature-icon { width: 36px; height: 36px; border-radius: 50%; background: var(--cream-dark); display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1rem; }
  .booking-feature-title { font-size: 0.9rem; font-weight: 700; color: var(--bark); }
  .booking-feature-desc { font-size: 0.85rem; color: var(--bark-light); }
  .calendly-embed {
    background: var(--cream); border: 1px solid var(--cream-dark);
    border-radius: 4px; overflow: hidden;
  }
  .calendly-placeholder-icon { font-size: 2.5rem; opacity: 0.3; }
  .calendly-placeholder-text { font-family: 'Playfair Display', serif; font-size: 1.1rem; color: var(--bark-light); font-style: italic; }
  .calendly-placeholder-sub { font-size: 0.82rem; color: var(--bark-light); opacity: 0.7; max-width: 280px; line-height: 1.6; }
  .calendly-btn { margin-top: 0.5rem; background: var(--forest); color: var(--white); padding: 0.75rem 1.75rem; text-decoration: none; font-size: 0.8rem; letter-spacing: 0.1em; text-transform: uppercase; border-radius: 2px; font-weight: 400; border: none; cursor: pointer; transition: background 0.2s; }
  .calendly-btn:hover { background: var(--forest-light); }

  /* CONTACT */
  #contact { background: var(--cream); }
  .contact-inner { display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: start; }
  .contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
  .form-field { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-field label { font-size: 0.75rem; letter-spacing: 0.1em; text-transform: uppercase; color: var(--bark-light); }
  .form-field input, .form-field select, .form-field textarea {
    background: var(--white); border: 1px solid var(--cream-dark); border-radius: 2px;
    padding: 0.7rem 1rem; font-family: 'Lato', sans-serif;
    font-size: 0.95rem; color: var(--bark); outline: none; transition: border-color 0.2s; width: 100%;
  }
  .form-field input:focus, .form-field select:focus, .form-field textarea:focus { border-color: var(--forest); }
  .form-field textarea { resize: vertical; min-height: 120px; }
  .form-submit { background: var(--forest); color: var(--white); padding: 0.85rem 2rem; border: none; cursor: pointer; font-family: 'Lato', sans-serif; font-size: 0.82rem; letter-spacing: 0.1em; text-transform: uppercase; border-radius: 2px; align-self: flex-start; transition: background 0.2s; }
  .form-submit:hover { background: var(--forest-light); }
  .contact-detail { display: flex; gap: 1rem; align-items: flex-start; margin-bottom: 1.25rem; }
  .contact-detail-icon { font-size: 1.1rem; margin-top: 2px; }
  .contact-detail-label { font-size: 0.72rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--terracotta); margin-bottom: 2px; }
  .contact-detail-value { font-size: 0.95rem; color: var(--bark-light); }

  /* FOOTER */
  footer { background: var(--forest-dark); color: rgba(253,250,245,0.6); padding: 3rem 2rem; text-align: center; }
  .footer-logo img { height: 56px; width: auto; margin-bottom: 0.75rem; }
  .footer-tagline { font-size: 0.85rem; margin-bottom: 1.5rem; }
  .footer-links { display: flex; gap: 1.5rem; justify-content: center; flex-wrap: wrap; margin-bottom: 1.5rem; }
  .footer-links a { color: rgba(253,250,245,0.5); text-decoration: none; font-size: 0.78rem; letter-spacing: 0.1em; text-transform: uppercase; transition: color 0.2s; }
  .footer-links a:hover { color: var(--white); }
  .footer-copy { font-size: 0.78rem; }

  /* RESPONSIVE */
  @media (max-width: 768px) {
    .nav-links { display: none; }
    .hamburger { display: flex; }
    .hero-inner { grid-template-columns: 1fr; gap: 2.5rem; }
    .hero-visual { display: none; }
    .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .booking-grid { grid-template-columns: 1fr; gap: 2rem; }
    .contact-inner { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (prefers-reduced-motion: reduce) { .service-card { transition: none; } }
</style>
