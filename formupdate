<!-- SERVICES -->
<section id="services">
  <div class="section-inner">
    <div class="services-intro">
      <p class="section-eyebrow">Services</p>
      <h2 class="section-title">How Thrive can help you.</h2>
      <p class="section-sub">Whether you're a student navigating applications or a school looking for expert consulting support, there's a path for you.</p>
    </div>
    <div class="services-grid">
      <div class="service-card">
        <div class="service-icon">📚</div>
        <h3 class="service-title">High School Planning</h3>
        <p class="service-desc">The college process begins long before senior year. From course selection and academic pacing to extracurriculars and summer experiences, I help students make intentional choices that reflect who they are and where they want to go.</p>
        <span class="service-tag">Students & Families</span>
